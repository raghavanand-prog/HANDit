{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "handit",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-19",
  // One official address: handit.<subdomain>.workers.dev. No per-version preview URLs.
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "../web/dist",
    // Paths like /j load the app; page loads never run the Worker, so they cost nothing. Only the
    // Room (/ws/*) and optional sign-in (/auth/*) do.
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/ws/*", "/auth/*"]
  },
  // Room: one per code. Limiter: one per client IP, for the per-IP limits.
  "durable_objects": {
    "bindings": [
      { "name": "ROOM", "class_name": "Room" },
      { "name": "LIMITER", "class_name": "Limiter" }
    ]
  },
  // The free plan only allows SQLite-backed Durable Objects.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room"] },
    { "tag": "v2", "new_sqlite_classes": ["Limiter"] }
  ],
  // Extra browser origins allowed to open a Room, for local development only (comma-separated).
  // Empty in production: only the site's own origin may connect.
  "vars": { "ALLOWED_ORIGINS": "" },
  // No request logs: nothing records room IDs, links or frames.
  "observability": { "enabled": false }
}
